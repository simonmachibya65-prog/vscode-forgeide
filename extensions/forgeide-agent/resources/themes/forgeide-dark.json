{
  "name": "ForgeIDE Dark",
  "type": "dark",
  "colors": {
    "editor.background":                    "#14161c",
    "editor.foreground":                    "#e6e8f0",
    "editor.lineHighlightBackground":       "#1e2030",
    "editor.selectionBackground":           "#7c5cff33",
    "editor.inactiveSelectionBackground":   "#7c5cff1a",
    "editorCursor.foreground":              "#7c5cff",
    "editorLineNumber.foreground":          "#3e4257",
    "editorLineNumber.activeForeground":    "#7c5cff",
    "editorGutter.addedBackground":         "#3ecf8e",
    "editorGutter.modifiedBackground":      "#f5b83d",
    "editorGutter.deletedBackground":       "#f2545b",
    "editorIndentGuide.background":         "#1e2030",
    "editorIndentGuide.activeBackground":   "#7c5cff44",

    "activityBar.background":               "#0e1015",
    "activityBar.foreground":               "#e6e8f0",
    "activityBar.inactiveForeground":       "#3e4257",
    "activityBarBadge.background":          "#7c5cff",
    "activityBarBadge.foreground":          "#ffffff",

    "sideBar.background":                   "#181a22",
    "sideBar.foreground":                   "#a9adc1",
    "sideBarTitle.foreground":              "#e6e8f0",
    "sideBarSectionHeader.background":      "#0e1015",
    "sideBarSectionHeader.foreground":      "#7c5cff",

    "list.activeSelectionBackground":       "#7c5cff33",
    "list.activeSelectionForeground":       "#e6e8f0",
    "list.hoverBackground":                 "#1e2030",
    "list.focusBackground":                 "#7c5cff22",

    "statusBar.background":                 "#0e1015",
    "statusBar.foreground":                 "#a9adc1",
    "statusBar.noFolderBackground":         "#0e1015",
    "statusBar.debuggingBackground":        "#7c5cff",
    "statusBarItem.hoverBackground":        "#7c5cff33",
    "statusBarItem.activeBackground":       "#7c5cff55",

    "titleBar.activeBackground":            "#0e1015",
    "titleBar.activeForeground":            "#e6e8f0",
    "titleBar.inactiveBackground":          "#0e1015",
    "titleBar.inactiveForeground":          "#3e4257",

    "tab.activeBackground":                 "#14161c",
    "tab.activeForeground":                 "#e6e8f0",
    "tab.inactiveBackground":               "#0e1015",
    "tab.inactiveForeground":               "#3e4257",
    "tab.activeBorderTop":                  "#7c5cff",
    "tab.border":                           "#0e1015",

    "panel.background":                     "#0e1015",
    "panel.border":                         "#1e2030",
    "panelTitle.activeForeground":          "#7c5cff",
    "panelTitle.activeBorder":              "#7c5cff",
    "panelTitle.inactiveForeground":        "#3e4257",

    "input.background":                     "#1e2030",
    "input.foreground":                     "#e6e8f0",
    "input.border":                         "#3e4257",
    "input.placeholderForeground":          "#3e4257",
    "inputOption.activeBorder":             "#7c5cff",
    "inputOption.activeBackground":         "#7c5cff33",

    "button.background":                    "#7c5cff",
    "button.foreground":                    "#ffffff",
    "button.hoverBackground":               "#6a4de0",
    "button.secondaryBackground":           "#1e2030",
    "button.secondaryForeground":           "#e6e8f0",

    "badge.background":                     "#7c5cff",
    "badge.foreground":                     "#ffffff",

    "focusBorder":                          "#7c5cff",
    "textLink.foreground":                  "#9b8bff",
    "textLink.activeForeground":            "#7c5cff",
    "textBlockQuote.background":            "#1e2030",
    "textBlockQuote.border":                "#7c5cff",
    "textCodeBlock.background":             "#1e2030",

    "dropdown.background":                  "#1e2030",
    "dropdown.foreground":                  "#e6e8f0",
    "dropdown.border":                      "#3e4257",

    "scrollbar.shadow":                     "#00000033",
    "scrollbarSlider.background":           "#3e425780",
    "scrollbarSlider.hoverBackground":      "#7c5cff55",
    "scrollbarSlider.activeBackground":     "#7c5cff99",

    "progressBar.background":               "#7c5cff",

    "diffEditor.insertedTextBackground":    "#3ecf8e18",
    "diffEditor.removedTextBackground":     "#f2545b18",

    "terminal.background":                  "#0e1015",
    "terminal.foreground":                  "#e6e8f0",
    "terminal.ansiBlack":                   "#14161c",
    "terminal.ansiRed":                     "#f2545b",
    "terminal.ansiGreen":                   "#3ecf8e",
    "terminal.ansiYellow":                  "#f5b83d",
    "terminal.ansiBlue":                    "#63b3ff",
    "terminal.ansiMagenta":                 "#9b8bff",
    "terminal.ansiCyan":                    "#3ecf8e",
    "terminal.ansiWhite":                   "#e6e8f0",
    "terminal.ansiBrightGreen":             "#3ecf8e",
    "terminal.ansiBrightBlue":              "#7c5cff",

    "gitDecoration.addedResourceForeground":     "#3ecf8e",
    "gitDecoration.modifiedResourceForeground":  "#f5b83d",
    "gitDecoration.deletedResourceForeground":   "#f2545b",
    "gitDecoration.untrackedResourceForeground": "#9b8bff",
    "gitDecoration.ignoredResourceForeground":   "#3e4257"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5b5f73", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#9b8bff" } },
    { "scope": ["keyword.operator"],
      "settings": { "foreground": "#7c5cff" } },
    { "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#3ecf8e" } },
    { "scope": ["string.template"],
      "settings": { "foreground": "#2eb87e" } },
    { "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#63b3ff" } },
    { "scope": ["entity.name.class", "entity.name.type"],
      "settings": { "foreground": "#f5b83d" } },
    { "scope": ["entity.name.tag"],
      "settings": { "foreground": "#f2545b" } },
    { "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#9b8bff" } },
    { "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#e6e8f0" } },
    { "scope": ["variable.language"],
      "settings": { "foreground": "#9b8bff", "fontStyle": "italic" } },
    { "scope": ["variable.parameter"],
      "settings": { "foreground": "#a9adc1" } },
    { "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": { "foreground": "#f5b83d" } },
    { "scope": ["support.type", "support.class"],
      "settings": { "foreground": "#63b3ff" } },
    { "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#f5b83d" } },
    { "scope": ["invalid"],
      "settings": { "foreground": "#f2545b", "fontStyle": "underline" } }
  ]
}
